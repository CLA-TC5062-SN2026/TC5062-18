' ============================================================
' TiendiNet - Diagramas de despliegue (UML)
' Contiene 2 escenarios:
'   1) diagrama_despliegue_piloto -> MVP: Docker Compose en equipo del proyecto + túnel HTTPS (SRS §2.1)
'   2) diagrama_despliegue_nube   -> Objetivo posterior: VM en la nube con el mismo docker-compose
' Render: java -jar plantuml.jar -tpng diagrama_despliegue.puml
' ============================================================

@startuml diagrama_despliegue_piloto
title TiendiNet - Despliegue del piloto MVP (Docker Compose + túnel HTTPS)

skinparam shadowing false
skinparam defaultFontName Arial
skinparam nodeBackgroundColor #F5F8FC
skinparam databaseBackgroundColor #E8F0FA
skinparam componentBackgroundColor #FFFFFF
skinparam ArrowColor #444444
left to right direction

node "PC del mostrador\n<<dispositivo>>\nWindows · Chrome / Edge" as pc {
  artifact "Portal Tienda (SPA)" as spa_t_pc
  component "Lector de código de barras\nUSB (emula teclado)" as lector
}
node "Celular Dueño / Empleado\n<<dispositivo>>\nAndroid · Chrome" as cel_t {
  artifact "Portal Tienda (SPA)" as spa_t_cel
}
node "Celular del cliente\n<<dispositivo>>\nAndroid Chrome / iOS Safari" as cel_c {
  artifact "Portal Clientes (SPA)" as spa_c
}

cloud "Internet" as internet {
  node "Cloudflare Tunnel\n<<servicio externo>>\nhttps://tiendinet.<dominio>" as edge
  node "Mercado Pago\n<<servicio externo>>\nsandbox" as mp
}

node "Equipo del proyecto\n<<servidor>>\nLinux / Windows + WSL2 · Docker Engine" as host {
  node "Docker Compose: red interna tiendinet_net" as compose {
    node "cloudflared\n<<contenedor>>" as c_tunnel
    node "proxy\n<<contenedor>>\nCaddy :80" as c_proxy {
      artifact "dist/portal-tienda" as a_ft
      artifact "dist/portal-clientes" as a_fc
    }
    node "api\n<<contenedor>>\nPython 3.12 · uvicorn :8000" as c_api {
      artifact "tiendinet-backend (imagen)" as a_api
    }
    node "worker\n<<contenedor>>\nPython 3.12 · APScheduler" as c_worker {
      artifact "tiendinet-backend (misma imagen)" as a_worker
    }
    node "db\n<<contenedor>>\nPostgreSQL 16 :5432" as c_db {
      database "tiendinet\n(BD concentradora)" as bd
    }
    node "proveedor-a\n<<contenedor>>\nPostgreSQL 16 :5432" as c_pa {
      database "proveedor_a" as bd_a
    }
    node "proveedor-b\n<<contenedor>>\nMySQL 8 :3306" as c_pb {
      database "proveedor_b" as bd_b
    }
    node "mailpit\n<<contenedor>>\nSMTP :1025 · UI :8025" as c_mail
  }
  storage "Volúmenes Docker\npg_data · prov_a_data · prov_b_data" as vol
}

lector --> spa_t_pc : USB HID
spa_t_pc --> edge : HTTPS
spa_t_cel --> edge : HTTPS
spa_c --> edge : HTTPS
spa_c ..> mp : HTTPS (redirección a Checkout Pro)
mp --> edge : HTTPS (webhook firmado)

edge <-- c_tunnel : túnel saliente (QUIC/HTTPS)
c_tunnel --> c_proxy : HTTP :80
c_proxy --> c_api : HTTP /api/* :8000
c_api --> c_db : SQL :5432
c_worker --> c_db : SQL :5432
c_worker --> c_pa : SQL :5432 (solo lectura)
c_worker --> c_pb : SQL :3306 (solo lectura)
c_worker --> c_mail : SMTP :1025
c_api --> mp : HTTPS (API REST)
c_worker --> mp : HTTPS (conciliación)
c_db .. vol
c_pa .. vol
c_pb .. vol

note bottom of compose
  Todos los contenedores: restart: unless-stopped y healthcheck (RNF-13).
  Solo cloudflared sale a internet; no se abren puertos entrantes.
  api y worker usan la misma imagen; worker corre en 1 sola réplica.
end note
@enduml


@startuml diagrama_despliegue_nube
title TiendiNet - Despliegue objetivo en la nube (posterior al MVP)

skinparam shadowing false
skinparam defaultFontName Arial
skinparam nodeBackgroundColor #F5F8FC
skinparam databaseBackgroundColor #E8F0FA
skinparam ArrowColor #444444

node "Navegadores\n<<dispositivo>>\nPC Windows · Android · iOS" as nav {
  artifact "Portal Tienda (SPA)" as spa_t
  artifact "Portal Clientes (SPA)" as spa_c
}

rectangle "Proveedor de nube (p. ej. DigitalOcean / AWS Lightsail)\n<<nube>>" as nube {
  node "VM Linux\n<<servidor virtual>>\n2 vCPU · 4 GB RAM · Docker Engine" as vm {
    node "proxy\n<<contenedor>>\nCaddy :443 (TLS Let's Encrypt)" as c_proxy {
      artifact "dist/portal-tienda" as a_ft
      artifact "dist/portal-clientes" as a_fc
    }
    node "api x2\n<<contenedor>>\nuvicorn :8000" as c_api
    node "worker x1\n<<contenedor>>\nAPScheduler" as c_worker
    node "proveedor-a / proveedor-b\n<<contenedores>>\nsimulados (solo lectura)" as c_provs
  }
  node "PostgreSQL gestionado\n<<servicio administrado>>\nrespaldos diarios automáticos" as pg {
    database "tiendinet\n(BD concentradora)" as bd
  }
  node "SMTP transaccional\n<<servicio externo>>" as smtp
  node "Monitor de disponibilidad\n<<servicio externo>>" as monitor
}

node "Mercado Pago\n<<servicio externo>>\nsandbox → producción (Fase 2)" as mp

spa_t --> c_proxy : HTTPS :443
spa_c --> c_proxy : HTTPS :443
spa_c ..> mp : HTTPS (Checkout Pro)
mp --> c_proxy : HTTPS (webhook firmado)
c_proxy --> c_api : HTTP /api/* (balanceo)
c_api --> bd : SQL/TLS :5432
c_worker --> bd : SQL/TLS :5432
c_worker --> c_provs : SQL (solo lectura)
c_worker --> smtp : SMTP/TLS :587
c_api --> mp : HTTPS (API REST)
c_worker --> mp : HTTPS (conciliación)
monitor --> c_proxy : GET /salud cada 1 min

note bottom of vm
  Mismo docker-compose.yml que el piloto; cambian solo variables de entorno:
  DATABASE_URL apunta al PostgreSQL gestionado, SMTP real y dominio propio.
  La API escala a 2 réplicas sin cambios (stateless, JWT);
  el worker se queda en 1 réplica con advisory lock.
end note
@enduml
