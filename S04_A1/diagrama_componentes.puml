' ============================================================
' TiendiNet - Diagramas de componentes (modelo C4)
' Contiene 2 diagramas:
'   1) diagrama_componentes_contenedores  -> C4 nivel 2 (Container)
'   2) diagrama_componentes_api           -> C4 nivel 3 (Component) del backend
' Fuente: SRS_equipo.md v2.0 y ADR-001
' Render: java -jar plantuml.jar -tpng diagrama_componentes.puml
' ============================================================

@startuml diagrama_componentes_contenedores
!include <C4/C4_Container>

title TiendiNet - Diagrama de contenedores (C4 nivel 2)

LAYOUT_TOP_DOWN()
SHOW_PERSON_OUTLINE()

Person(dueno, "Dueño", "Administra precios, costos, proveedores, configuración, usuarios y reportes. PC Windows y Android.")
Person(empleado, "Empleado", "Cobra en mostrador, hace corte, recibe mercancía y prepara pedidos.")
Person(cliente, "Cliente", "Vecino que compra desde su celular.")

System_Boundary(tiendinet, "TiendiNet") {
  Container(portal_tienda, "Portal Tienda", "React + Vite + TypeScript (SPA)", "POS, inventario, proveedores, pedidos, configuración y reportes. Operable con teclado, táctil y lector USB.")
  Container(portal_clientes, "Portal Clientes", "React + Vite + TypeScript (SPA)", "Catálogo público, carrito, pago anticipado, Mis pedidos y faltantes.")
  Container(proxy, "Proxy inverso", "Caddy", "Sirve los estáticos de ambas SPA y enruta /api/* hacia la API.")
  Container(api, "API REST", "Python 3.12 + FastAPI + SQLAlchemy", "Monolito modular: 7 módulos de dominio, seguridad JWT por rol, auditoría y unidad de trabajo transaccional. Expone openapi.yaml.")
  Container(worker, "Worker programador", "Python + APScheduler (mismo código que la API)", "Sincroniza proveedores (5:00), recalcula PR (6:00), avisa caducidades (7:00), expira apartados, concilia pagos (10 min) y marca no recogidos (20:00). Envía correos pendientes.")
  ContainerDb(bd, "BD concentradora", "PostgreSQL 16", "Productos, lotes, ofertas, ventas, cortes, pedidos, pagos, reembolsos, alertas y auditoría.")
}

System_Ext(prov_a, "BD Proveedor A", "PostgreSQL, esquema propio (solo lectura)")
System_Ext(prov_b, "BD Proveedor B", "MySQL, esquema distinto (solo lectura)")
System_Ext(mp, "Mercado Pago", "Checkout Pro sandbox: pagos, webhooks, reembolsos y consulta")
System_Ext(smtp, "Servidor SMTP", "Mailpit en local / proveedor SMTP en nube")

Rel(dueno, portal_tienda, "Usa", "HTTPS")
Rel(empleado, portal_tienda, "Usa", "HTTPS")
Rel(cliente, portal_clientes, "Usa", "HTTPS")
Rel_R(cliente, mp, "Paga en el checkout de MP", "HTTPS (redirección)")

Rel(portal_tienda, proxy, "Llama a /api", "HTTPS / JSON + JWT")
Rel(portal_clientes, proxy, "Llama a /api", "HTTPS / JSON + JWT")
Rel(proxy, api, "Reenvía peticiones", "HTTP / JSON")

Rel(api, bd, "Lee y escribe en una transacción con bloqueo por fila", "SQL / TCP 5432")
Rel(worker, bd, "Lee y escribe", "SQL / TCP 5432")
Rel(worker, prov_a, "Lee catálogo, costo, existencia y días de entrega", "SQL / TCP, solo lectura")
Rel(worker, prov_b, "Lee catálogo, costo, existencia y días de entrega", "SQL / TCP, solo lectura")

Rel(api, mp, "Crea preferencia de pago y reembolsos", "HTTPS / REST")
Rel(mp, proxy, "Notifica pagos y reembolsos (webhook firmado)", "HTTPS")
Rel(worker, mp, "Concilia pagos y reembolsos", "HTTPS / REST")
Rel(worker, smtp, "Envía correos", "SMTP")

SHOW_LEGEND()
@enduml


@startuml diagrama_componentes_api
!include <C4/C4_Component>

title TiendiNet - Componentes del backend (C4 nivel 3: API REST y Worker)

LAYOUT_TOP_DOWN()

Container(portales, "Portal Tienda / Portal Clientes", "SPA React", "Consumen el contrato OpenAPI")
System_Ext(mp, "Mercado Pago", "sandbox")
System_Ext(provs, "BD Proveedores A y B", "solo lectura")
System_Ext(smtp, "SMTP", "Mailpit")
ContainerDb(bd, "BD concentradora", "PostgreSQL 16")

Container_Boundary(backend, "Backend TiendiNet (un código, dos procesos: API y Worker)") {

  Component(seguridad, "Seguridad", "Dependencia FastAPI", "Valida JWT, cuenta activa, rol y límite de intentos (RF-01, RNF-04/05/10)")
  Component(planificador, "Planificador", "APScheduler (proceso Worker)", "Dispara los procesos de reloj con advisory lock")

  Component(m_acceso, "Acceso", "Router + servicio", "Login, registro, recuperación, usuarios (RF-01 a 03)")
  Component(m_inv, "Catálogo e inventario", "Router + servicio", "Productos, lotes, recepciones, ajustes, FEFO, PR y alertas (RF-04 a 09)")
  Component(m_prov, "Proveedores y compras", "Router + servicio", "Sincronización, ofertas, comparación, sugerencia, propuesta (RF-10 a 14)")
  Component(m_pos, "Punto de venta", "Router + servicio", "Venta, comprobante, cancelación, diferidas, corte (RF-15 a 20)")
  Component(m_ped, "Pedidos en línea", "Router + servicio", "Catálogo, pedido, máquina de estados, faltantes (RF-21, 22, 24 a 26)")
  Component(m_pag, "Pagos y reembolsos", "Router + servicio", "Webhook, conciliación, reembolsos (RF-23, 27)")
  Component(m_adm, "Administración", "Router + servicio", "Configuración, reportes e indicadores (RF-28, 29)")

  Component(uow, "Unidad de trabajo + repositorios", "SQLAlchemy 2", "Una transacción por caso de uso; SELECT ... FOR UPDATE sobre cada producto, en orden de id (RNF-06)")
  Component(auditoria, "Auditoría", "Servicio transversal", "Registro inmutable en la misma transacción (RNF-07)")

  Component(i_prov, "«interfaz» AdaptadorProveedor", "Puerto", "leerOfertas(): list[OfertaNormalizada]")
  Component(a_prov_a, "AdaptadorProveedorA", "Adaptador", "Mapea el esquema de A")
  Component(a_prov_b, "AdaptadorProveedorB", "Adaptador", "Mapea el esquema de B")

  Component(i_pag, "«interfaz» ServicioPagos", "Puerto", "crearPreferencia(), verificarFirma(), consultarPago(), reembolsar()")
  Component(a_mp, "PagosMercadoPago", "Adaptador", "SDK de Mercado Pago, sandbox")
  Component(a_sim, "PagosSimulado", "Adaptador", "Doble de prueba para pytest")

  Component(i_correo, "«interfaz» ServicioCorreo", "Puerto", "enviar(destinatario, plantilla, datos)")
  Component(a_smtp, "CorreoSMTP", "Adaptador", "smtplib")
}

Rel(portales, seguridad, "Peticiones autenticadas", "HTTPS / JSON + JWT")
Rel(mp, m_pag, "Webhook firmado", "HTTPS")

Rel(seguridad, m_acceso, "Autoriza")
Rel(seguridad, m_pos, "Autoriza")
Rel(seguridad, m_ped, "Autoriza")
Rel(seguridad, m_inv, "Autoriza")
Rel(seguridad, m_prov, "Autoriza")
Rel(seguridad, m_adm, "Autoriza")

Rel(m_pos, m_inv, "Descontar / reintegrar existencias (FEFO)")
Rel(m_ped, m_inv, "Apartar, liberar y entregar")
Rel(m_ped, m_pag, "Solicitar pago y reembolso")
Rel(m_pag, m_ped, "Marcar pedido pagado")
Rel(m_prov, m_inv, "Días de entrega para el PR")
Rel(m_adm, m_pos, "Lee ventas y cortes")

Rel(planificador, m_prov, "Sincronizar 5:00")
Rel(planificador, m_inv, "PR 6:00, caducidades 7:00")
Rel(planificador, m_ped, "Expirar 15 min, no recogidos 20:00")
Rel(planificador, m_pag, "Conciliar cada 10 min")

Rel(m_prov, i_prov, "Usa")
Rel(a_prov_a, i_prov, "Implementa")
Rel(a_prov_b, i_prov, "Implementa")
Rel(a_prov_a, provs, "Lee", "SQL")
Rel(a_prov_b, provs, "Lee", "SQL")

Rel(m_pag, i_pag, "Usa")
Rel(a_mp, i_pag, "Implementa")
Rel(a_sim, i_pag, "Implementa")
Rel(a_mp, mp, "Llama", "HTTPS / REST")

Rel(planificador, i_correo, "Envía correos pendientes")
Rel(a_smtp, i_correo, "Implementa")
Rel(a_smtp, smtp, "Envía", "SMTP")

Rel(m_inv, uow, "Persiste")
Rel(m_pos, uow, "Persiste")
Rel(m_ped, uow, "Persiste")
Rel(m_pag, uow, "Persiste")
Rel(uow, auditoria, "Registra cada operación")
Rel(uow, bd, "Lee y escribe", "SQL")

SHOW_LEGEND()
@enduml
