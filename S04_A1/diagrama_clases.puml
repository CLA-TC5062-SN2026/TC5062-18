' ============================================================
' TiendiNet - Diagrama de clases del dominio (versión final)
' Base: propuesta v0 del agente, revisada contra el SRS v2.0
' Decisiones propias aplicadas:
'   D1 Precio histórico en renglones + SalidaLote (FEFO trazable)
'   D2 Multiplicidades Pedido-Pago-Reembolso
'   D3 Proveedor sin herencia: TipoProveedor, OrigenOferta, ProductoPorVincular
'   D4 CorteCaja-Venta como asociación, no composición
'   D5 Usuario con Rol (enum) + PerfilCliente, sin herencia
'   D6 Existencias derivadas de lotes y renglones de pedido
'   D7 Estados como enumeraciones + historial de pedido
'   D8 Ajustes de consistencia con el SRS (PR, cancelación, alertas, auditoría, propuesta)
' Contiene 2 diagramas: diagrama_clases (entidades) y diagrama_clases_enumeraciones (tipos)
' Render: java -jar plantuml.jar -tpng diagrama_clases.puml
' ============================================================
@startuml diagrama_clases
title TiendiNet - Diagrama de clases del dominio (versión final)

skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 50
hide empty methods

skinparam class {
  BackgroundColor<<enum>> #F7F7F7
}

' ---------------- ACCESO ----------------
package "Acceso" {
  class Usuario {
    id: int
    nombre: String
    correo: String {unique}
    hashContrasena: String
    rol: Rol
    activo: bool
  }
  class PerfilCliente {
    telefono: String
    direccion: String
    codigoPostal: String
    aceptoAvisoPrivacidad: bool
    fechaAceptacion: DateTime
  }
  Usuario "1" *-- "0..1" PerfilCliente
}

' ---------------- CATÁLOGO E INVENTARIO ----------------
package "Catálogo e inventario" {
  class Categoria {
    id: int
    nombre: String
  }
  class Producto {
    id: int
    codigoBarras: String [0..1] {unique}
    nombre: String
    presentacion: String
    precioVenta: Decimal
    costoReferencia: Decimal
    perecedero: bool
    restringido: bool
    activo: bool
    descuadre: bool
    prInicial: int
    prVigente: int
    prOrigen: OrigenPR
    prManual: int [0..1]
    prManualVigencia: Date [0..1]
    cdp: Decimal [0..1]
    diasEntregaRespaldo: int [0..1]
    /existenciaFisica: int
    /apartado: int
    /disponible: int
  }
  class Lote {
    id: int
    cantidadRecibida: int
    cantidadActual: int
    fechaCaducidad: Date [0..1]
    costoUnitario: Decimal [0..1]
    fechaRecepcion: DateTime
    /caducado: bool
  }
  class MovimientoInventario {
    id: int
    tipo: TipoMovimiento
    cantidad: int
    cantidadAnterior: int
    cantidadNueva: int
    motivo: String [0..1]
    fechaHora: DateTime
  }
  class Alerta {
    id: int
    tipo: TipoAlerta
    estado: EstadoAlerta
    fechaCreacion: DateTime
    fechaResolucion: DateTime [0..1]
  }
  Categoria "1" -- "0..*" Producto
  Producto "1" *-- "0..*" Lote
  Producto "1" -- "0..*" MovimientoInventario
  MovimientoInventario "0..*" --> "0..1" Lote
  Alerta "0..*" --> "1" Producto
  Alerta "0..*" --> "0..1" Lote
}

' ---------------- PROVEEDORES Y COMPRAS ----------------
package "Proveedores y compras" {
  class Proveedor {
    id: int
    nombre: String
    tipo: TipoProveedor
  }
  class Oferta {
    id: int
    origen: OrigenOferta
    codigoProveedor: String
    presentacion: String
    factorConversion: int
    costo: Decimal
    existenciaProveedor: int
    diasEntrega: int
    fechaActualizacion: DateTime
    /costoPorUnidadBase: Decimal
    /vigente: bool
  }
  class ProductoPorVincular {
    id: int
    codigoProveedor: String
    nombre: String
    presentacion: String
    fechaDeteccion: DateTime
  }
  class PropuestaCompra {
    id: int
    fechaCreacion: DateTime
  }
  class RenglonPropuesta {
    cantidad: int
    costoUnitario: Decimal
  }
  Proveedor "1" *-- "0..*" Oferta
  Proveedor "1" *-- "0..*" ProductoPorVincular
  Oferta "0..*" --> "1" Producto
  Producto "0..*" --> "0..1" Proveedor : preferido
  Lote "0..*" --> "1" Proveedor : surtido por
  PropuestaCompra "1" *-- "1..*" RenglonPropuesta
  RenglonPropuesta "0..*" --> "1" Producto
  RenglonPropuesta "0..*" --> "0..1" Proveedor : sugerido
}

' ---------------- PUNTO DE VENTA ----------------
package "Punto de venta" {
  class Venta {
    folio: int {unique}
    total: Decimal
    metodoPago: MetodoPago
    montoRecibido: Decimal [0..1]
    cambio: Decimal [0..1]
    estado: EstadoVenta
    diferida: bool
    fechaHora: DateTime
    fechaCaptura: DateTime
    motivoCancelacion: String [0..1]
    fechaCancelacion: DateTime [0..1]
  }
  class RenglonVenta {
    cantidad: int
    precioUnitario: Decimal
    subtotal: Decimal
  }
  class SalidaLote {
    cantidad: int
  }
  class CorteCaja {
    id: int
    fechaHora: DateTime
    efectivoEsperado: Decimal
    efectivoContado: Decimal
    diferencia: Decimal
    totalTarjeta: Decimal
  }
  Venta "1" *-- "1..*" RenglonVenta
  RenglonVenta "0..*" --> "1" Producto
  RenglonVenta "1" *-- "0..*" SalidaLote
  SalidaLote "0..*" --> "1" Lote
  Venta "0..*" -- "0..1" CorteCaja : incluida en
}

' ---------------- TIENDA EN LÍNEA ----------------
package "Tienda en línea" {
  class Pedido {
    folio: int {unique}
    modalidad: Modalidad
    direccionEntrega: String [0..1]
    codigoPostal: String [0..1]
    subtotal: Decimal
    costoEnvio: Decimal
    total: Decimal
    estado: EstadoPedido
    fechaCreacion: DateTime
    pagoVenceEn: DateTime
    fechaProgramada: Date [0..1]
    respuestaFaltanteVenceEn: DateTime [0..1]
  }
  class RenglonPedido {
    cantidad: int
    precioUnitario: Decimal
    cantidadApartada: int
    cantidadFaltante: int
  }
  class CambioEstadoPedido {
    estadoAnterior: EstadoPedido
    estadoNuevo: EstadoPedido
    fechaHora: DateTime
    nota: String [0..1]
  }
  class Pago {
    referenciaServicio: String {unique}
    monto: Decimal
    estado: EstadoPago
    fechaHora: DateTime
  }
  class Reembolso {
    monto: Decimal
    motivo: MotivoReembolso
    estado: EstadoReembolso
    fechaHora: DateTime
  }
  Pedido "1" *-- "1..*" RenglonPedido
  Pedido "1" *-- "1..*" CambioEstadoPedido
  RenglonPedido "0..*" --> "1" Producto
  RenglonPedido "0..1" --> "0..1" RenglonPedido : sustituye a
  RenglonPedido "1" *-- "0..*" SalidaLote
  Pedido "1" -- "0..*" Pago
  Pago "1" -- "0..*" Reembolso
  Reembolso "0..*" --> "0..1" RenglonPedido : faltante
}

' ---------------- ADMINISTRACIÓN ----------------
package "Administración" {
  class Configuracion <<singleton>> {
    diasSeguridad: int {0..14}
    codigosPostales: String [1..*]
    pedidoMinimoEnvio: Decimal
    costoEnvio: Decimal
    horaApertura: Time
    horaCierre: Time
    horaLimiteMismoDia: Time
    diasAvisoCaducidad: int
    minutosRespuestaFaltante: int
  }
  class RegistroAuditoria {
    id: int
    fechaHora: DateTime
    operacion: String
    entidad: String
    idEntidad: String
    valorAnterior: JSON [0..1]
    valorNuevo: JSON [0..1]
    resultado: String
  }
}

' ---------------- RELACIONES CON USUARIO ----------------
Usuario "1" -- "0..*" Venta : responsable
Usuario "0..1" -- "0..*" Venta : canceló
Usuario "1" -- "0..*" CorteCaja : realizó
Usuario "1" -- "0..*" MovimientoInventario : registró
Usuario "1" -- "0..*" Pedido : cliente
Usuario "0..1" -- "0..*" Pedido : asignado
Usuario "0..1" -- "0..*" CambioEstadoPedido : realizó
Usuario "0..1" -- "0..*" RegistroAuditoria : actor
Usuario "1" -- "0..*" PropuestaCompra : generó

note bottom of Producto
  Derivados (consulta indexada, no se almacenan):
  /existenciaFisica = Σ Lote.cantidadActual
  /apartado = Σ RenglonPedido.cantidadApartada
     de pedidos no entregados ni cancelados
  /disponible = Σ cantidadActual de lotes no caducados
     − /apartado
end note

note bottom of SalidaLote
  {xor} pertenece a un RenglonVenta
  o a un RenglonPedido (entrega), nunca a ambos.
  Permite reintegrar a los lotes de origen (RF-18).
end note

note top of RegistroAuditoria
  Polimórfico (entidad + idEntidad): no se asocia
  a cada clase. Solo inserción (RNF-07).
end note
@enduml


@startuml diagrama_clases_enumeraciones
title TiendiNet - Enumeraciones del dominio (tipos usados en diagrama_clases)

skinparam shadowing false
skinparam defaultFontName Arial
skinparam classAttributeIconSize 0
hide empty methods
skinparam class {
  BackgroundColor<<enum>> #F7F7F7
}

package "Enumeraciones" {
  enum Rol <<enum>> {
    DUENO
    EMPLEADO
    CLIENTE
  }
  enum OrigenPR <<enum>> {
    INICIAL
    CALCULADO
    MANUAL
  }
  enum TipoMovimiento <<enum>> {
    RECEPCION
    VENTA
    MERMA
    CONTEO
    CANCELACION
    ENTREGA_PEDIDO
    FALTANTE
  }
  enum TipoAlerta <<enum>> {
    REORDEN
    POR_CADUCAR
    CADUCADO
  }
  enum EstadoAlerta <<enum>> {
    ACTIVA
    RESUELTA
  }
  enum TipoProveedor <<enum>> {
    SINCRONIZADO
    MANUAL
    RUTA
  }
  enum OrigenOferta <<enum>> {
    SINCRONIZADA
    MANUAL
  }
  enum MetodoPago <<enum>> {
    EFECTIVO
    TARJETA_TERMINAL
  }
  enum EstadoVenta <<enum>> {
    COMPLETADA
    CANCELADA
  }
  enum Modalidad <<enum>> {
    RECOGER_EN_TIENDA
    ENVIO_A_DOMICILIO
  }
  enum EstadoPedido <<enum>> {
    PENDIENTE_DE_PAGO
    EXPIRADO
    PAGADO
    EN_PREPARACION
    ESPERANDO_RESPUESTA_CLIENTE
    LISTO_PARA_RECOGER
    LISTO_PARA_ENVIAR
    EN_CAMINO
    ENTREGADO
    NO_RECOGIDO
    CANCELADO
  }
  enum EstadoPago <<enum>> {
    PENDIENTE
    APROBADO
    RECHAZADO
  }
  enum EstadoReembolso <<enum>> {
    SOLICITADO
    CONFIRMADO
    FALLIDO
  }
  enum MotivoReembolso <<enum>> {
    CANCELACION_CLIENTE
    FALTANTE
    PAGO_SIN_EXISTENCIA
    NO_RECOGIDO
  }
}

@enduml
