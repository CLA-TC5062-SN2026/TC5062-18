# Copia este archivo a .env y ajusta los valores. El .env nunca se sube al repo.

# Conexión a la base concentradora (PostgreSQL 16)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tiendinet
DB_USER=tiendinet
DB_PASSWORD=cambia-esta-contrasena

# JWT. El secreto debe tener 32 caracteres o más; genera uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=pega-aqui-un-secreto-largo-y-aleatorio
# Minutos de vida del token: 60 para Dueño y Empleado, 1440 (24 h) para Cliente
JWT_EXPIRATION=60
JWT_EXPIRATION_CLIENTE=1440

# Costo de bcrypt (10 a 15). 12 tarda unos 250 ms por contraseña.
BCRYPT_ROUNDS=12

# Solo desarrollo: muestra en consola el token de activación de cuentas nuevas
MOSTRAR_ENLACES_EN_CONSOLA=false

# Puerto de la API
API_PORT=8000
