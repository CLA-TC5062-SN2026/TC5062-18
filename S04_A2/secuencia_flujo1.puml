' ============================================================
' TiendiNet - Flujo 1: Venta en mostrador (POS)
' Endpoints: GET /api/v1/productos, POST /api/v1/ventas (openapi.yaml)
' Criterios: RF-15-AC-2, RF-16-AC-1, RF-16-AC-3, RF-16-AC-5, RF-16-AC-6,
'            RF-07-AC-4, RF-09-AC-1, RNF-06, RNF-07
' Render: java -jar plantuml.jar -tpng secuencia_flujo1.puml
' ============================================================
@startuml secuencia_flujo1
title Flujo 1 - Venta en mostrador con descuento FEFO y bloqueo por producto

skinparam shadowing false
skinparam defaultFontName Arial
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
skinparam ParticipantPadding 12
skinparam BoxPadding 8
autonumber "<b>[0]"

actor "Empleado\n(navegador Chrome)" as emp
box "Frontend" #F3F7FD
  participant "Portal Tienda\n(React SPA)" as spa
end box
box "Backend (contenedor api)" #F4FBF4
  participant "Seguridad\n(JWT + rol)" as seg
  participant "Router /ventas\n+ ServicioVentas" as svc
  participant "Unidad de trabajo\n(SQLAlchemy)" as uow
end box
database "PostgreSQL\n(BD concentradora)" as bd

== Buscar producto por código (RF-15-AC-2) ==
emp -> spa : Escanea código 7501055300075\n(lector USB = teclado + Enter)
spa -> seg : GET /api/v1/productos?codigoBarras=7501055300075\nAuthorization: Bearer <JWT>
seg -> bd : SELECT activo, rol FROM usuario WHERE id = :sub
bd --> seg : activo = true, rol = EMPLEADO
seg -> svc : listarProductos(filtros)
svc -> bd : SELECT producto + disponible\n(Σ lotes no caducados − Σ apartado)
bd --> svc : Aceite vegetal 1 L, $38.50, disponible 27
svc --> spa : <b>200 OK</b> {datos: [Producto], paginacion}
spa --> emp : Muestra nombre, precio y disponible

== Armar la venta (sin llamadas a la API) ==
emp -> spa : Cantidad 2, método EFECTIVO, recibido $100.00
spa -> spa : Calcula total $77.00 y cambio $23.00\n(RF-16-AC-2: el inventario no cambia hasta confirmar)

== Confirmar venta (RF-16-AC-1) ==
emp -> spa : Confirmar
spa -> spa : Genera Idempotency-Key (UUID v4)
spa -> seg : POST /api/v1/ventas\nIdempotency-Key: 6f1c…\n{renglones: [{productoId: 12, cantidad: 2}],\n metodoPago: EFECTIVO, montoRecibido: 100.00}
seg -> svc : confirmarVenta(VentaCrear, usuario)
svc -> bd : SELECT respuesta FROM idempotencia WHERE clave = '6f1c…'
bd --> svc : (sin registro)

svc -> svc : Valida esquema y cantidades enteras > 0
alt cantidad inválida o montoRecibido < total (RF-16-AC-3, AC-7)
  svc --> spa : <b>422</b> problem+json\ncodigo VALIDACION, "Faltan $2.50"
  spa --> emp : Muestra el error; la venta sigue en pantalla
else datos válidos
  svc -> uow : begin()
  uow -> bd : BEGIN
  uow -> bd : SELECT … FROM producto WHERE id IN (12)\nORDER BY id FOR UPDATE
  note right of bd
    El bloqueo serializa ventas, pedidos y
    webhooks sobre el mismo producto (RNF-06).
    Orden por id = sin interbloqueos.
  end note
  uow -> bd : SELECT disponible del producto 12
  bd --> uow : 27

  alt disponible < solicitada (RF-16-AC-5, AC-6)
    uow -> bd : ROLLBACK
    svc --> spa : <b>409 Conflict</b> problem+json\ncodigo PRODUCTO_AGOTADO,\nproductosAgotados [{productoId, solicitada, disponible}]
    spa --> emp : "Producto agotado" (resalta el renglón)
  else hay disponible
    uow -> bd : INSERT venta (folio = nextval, COMPLETADA, usuario, fechaHora)
    uow -> bd : INSERT renglon_venta (cantidad 2, precioUnitario 38.50)
    uow -> bd : SELECT lotes no caducados ORDER BY fechaCaducidad\n(incluye los que caducan hoy, RF-07-AC-4)
    loop por cada lote hasta cubrir la cantidad (FEFO)
      uow -> bd : UPDATE lote SET cantidadActual = cantidadActual − n
      uow -> bd : INSERT salida_lote (renglon, lote, n)
      uow -> bd : INSERT movimiento_inventario (VENTA, anterior, nueva)
    end
    opt nueva disponible <= PR (RF-09-AC-1)
      uow -> bd : INSERT/UPDATE alerta REORDEN (una activa por producto)
      uow -> bd : INSERT correo_pendiente (outbox para el worker)
    end
    uow -> bd : INSERT registro_auditoria (RNF-07)
    uow -> bd : INSERT idempotencia (clave, respuesta 201)
    uow -> bd : COMMIT
    svc --> spa : <b>201 Created</b>\nLocation: /api/v1/ventas/1045\n{folio 1045, total 77.00, cambio 23.00, COMPLETADA}
    spa --> emp : Muestra comprobante y cambio $23.00
  end
end

== Reintento por internet intermitente ==
opt la respuesta se perdió y el portal reintenta con la misma clave
  spa -> seg : POST /api/v1/ventas\nIdempotency-Key: 6f1c… (mismo cuerpo)
  seg -> svc : confirmarVenta(...)
  svc -> bd : SELECT respuesta FROM idempotencia WHERE clave = '6f1c…'
  bd --> svc : respuesta 201 guardada
  svc --> spa : <b>201 Created</b> (misma venta 1045, sin descontar de nuevo)
end
@enduml
